# IBM WatsonX AI Credentials
WATSONX_API_KEY=your_ibm_watsonx_api_key_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_VISION_MODEL_ID=ibm/granite-vision-3.2-2b

# IBM Watson Text-to-Speech
WATSON_TTS_API_KEY=your_watson_tts_api_key_here
WATSON_TTS_ENDPOINT=https://api.us-south.text-to-speech.watson.cloud.ibm.com/instances/your_instance_id

# Server Config
PORT=5001
CORS_ORIGINS=*
